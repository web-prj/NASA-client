<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dayNavigation" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="@dimen/page_padding">
    <Button android:id="@+id/buttonToday" style="@style/SpaceButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_marginStart="@dimen/space_small" android:text="@string/today" android:textColor="@color/accent" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toStartOf="@id/buttonToday" android:orientation="horizontal" android:background="@drawable/card_background">
        <Button android:id="@+id/buttonPrevious" style="@style/SpaceButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:text="@string/previous_day" />
        <Button android:id="@+id/buttonPickDate" style="@style/SpaceButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?android:attr/selectableItemBackground" android:text="@string/pick_date" android:contentDescription="@string/pick_date" />
        <Button android:id="@+id/buttonNext" style="@style/SpaceButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:text="@string/next_day" />
    </LinearLayout>
</RelativeLayout>
